		margin-top: 8rpx;
		font-size: 22rpx;
		color: #888;
	}

	.form-block {
		background-color: #fff;
		border-radius: 16rpx;
		margin-left: 24rpx;
		margin-right: 24rpx;
		padding: 0 24rpx;
	}

	.form-row {
		flex-direction: row;
		align-items: center;
		padding: 28rpx 0;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #eee;
	}

	.form-row-last:last-child {
		border-bottom-width: 0;
	}

	.form-label {
		font-size: 28rpx;
