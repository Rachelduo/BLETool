<template>
	<scroll-view class="page-scroll" scroll-y="true">
		<view class="section hint">
			<text class="hint-text">（打开蓝牙后，点击图标进行设备连接）</text>
		</view>

		<view class="section actions">
			<view class="action-circle" @click="onDeviceClick">
				<view class="device-icon-wrap" :class="{ connected: bleConnected }">
					<text class="device-emoji">📏</text>
				</view>
				<text class="action-label">楼板厚度</text>
				<text class="status-text">{{ bleStatusText }}</text>
			</view>
		</view>

		<view class="section form-block">
			<view class="form-row">
				<text class="form-label">测量内容</text>
				<text class="form-value">{{ contentLabel }}</text>
			</view>
			<view class="form-row form-row-last">
				<text class="form-label">测量仪器</text>
				<text class="form-value">{{ instrumentLabel }}</text>
			</view>
		</view>

		<view class="section upload-block">
			<text class="block-title">上传现场图片</text>
			<text class="sub-hint">（图片内容最好体现测区的划分）</text>
			<view class="upload-row" @click="choosePhoto">
				<image v-if="photoPath.length > 0" class="preview" :src="photoPath" mode="aspectFill" />
				<view v-else class="upload-placeholder">
					<text class="plus">+</text>
					<text class="upload-text">选择图片</text>
				</view>
			</view>
		</view>

		<view class="section area-block" v-for="(val, ai) in areaValues" :key="ai">
			<text class="area-title">测量区{{ ai + 1 }}</text>
			<view
				class="value-box"
				:class="{ active: activeAreaIndex == ai }"
				@click="focusArea(ai)"
			>
				<input
					class="value-input"
					type="text"
					:value="areaValues[ai]"
					placeholder="数值1"
					@focus="focusArea(ai)"
					@input="onAreaInput(ai, $event)"
				/>
			</view>
		</view>

		<button class="submit-btn" type="primary" @click="onSubmit">提交</button>
		<view class="bottom-space" />
	</scroll-view>
</template>

<script setup lang="uts">
	const AREA_COUNT = 4

	const contentLabel = '楼板厚度'
	const instrumentLabel = '楼板测厚仪'

	const bleConnected = ref(false)
	const bleStatusText = ref('未连接')
	const photoPath = ref('')
	const activeAreaIndex = ref(0)

	function buildEmptyValues(): Array<string> {
		const list = new Array<string>()
		for (let i = 0; i < AREA_COUNT; i++) {
			list.push('')
		}
		return list
	}

	const areaValues = ref<Array<string>>(buildEmptyValues())

	function focusArea(ai: number) {
		activeAreaIndex.value = ai
	}

	function onAreaInput(ai: number, e: UniInputEvent) {
		const next = areaValues.value.slice(0)
		next[ai] = e.detail.value as string
		areaValues.value = next
		activeAreaIndex.value = ai
	}

	function onDeviceClick() {
		// #ifdef MP-WEIXIN
		uni.showToast({ title: '蓝牙连接功能开发中', icon: 'none' })
		// #endif
		// #ifndef MP-WEIXIN
		uni.showToast({ title: '请在微信小程序中连接设备', icon: 'none' })
		// #endif
	}

	function choosePhoto() {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				const paths = res.tempFilePaths
				if (paths.length > 0) {
					photoPath.value = paths[0]
				}
			},
		})
	}

	function onSubmit() {
		const payload = {
			content: contentLabel,
			instrument: instrumentLabel,
			photo: photoPath.value,
			areas: areaValues.value,
		}
		console.log('floorSlab submit', payload)
		uni.showToast({ title: '已提交', icon: 'success' })
	}
</script>

